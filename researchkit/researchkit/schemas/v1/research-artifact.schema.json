{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galahad.local/schemas/v1/research-artifact.schema.json",
  "title": "ResearchArtifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "research_type",
    "subject",
    "claim",
    "claim_type",
    "evidence_refs",
    "confidence",
    "alternatives",
    "invalidation",
    "authoring_model",
    "created_at",
    "as_of_cutoff"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "research"},
    "artifact_id": {"type": "string", "pattern": "^res_[0-9a-f]{64}$"},
    "research_type": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "claim_type": {"enum": ["fact", "judgment"]},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "json_pointer"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "json_pointer": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "alternatives": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "invalidation": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authoring_model": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "as_of_cutoff": {"type": "string", "format": "date-time"}
  }
}
