{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galahad.local/schemas/v1/source-artifact.schema.json",
  "title": "SourceArtifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "provider",
    "canonical_uri",
    "query",
    "source_published_at",
    "source_available_at",
    "retrieved_at",
    "as_of_cutoff",
    "identifiers",
    "timezone",
    "currency",
    "unit",
    "adjustment_basis",
    "rights_tag",
    "content_hash",
    "snapshot_path"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "source"},
    "artifact_id": {"type": "string", "pattern": "^src_[0-9a-f]{64}$"},
    "provider": {"type": "string", "minLength": 1},
    "canonical_uri": {"type": "string", "minLength": 1},
    "query": {"type": "string"},
    "source_published_at": {"type": "string", "format": "date-time"},
    "source_available_at": {"type": "string", "format": "date-time"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "as_of_cutoff": {"type": "string", "format": "date-time"},
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "security_id": {"type": ["string", "null"]},
        "accession": {"type": ["string", "null"]}
      }
    },
    "timezone": {"type": "string", "minLength": 1},
    "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
    "unit": {"type": "string", "minLength": 1},
    "adjustment_basis": {"type": "string", "minLength": 1},
    "rights_tag": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "snapshot_path": {"type": "string", "minLength": 1}
  }
}
