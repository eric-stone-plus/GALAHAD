{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galahad.local/schemas/v2/source-artifact.schema.json",
  "title": "SourceArtifact v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "source_kind",
    "provider",
    "canonical_uri",
    "query",
    "source_published_at",
    "source_available_at",
    "availability_basis",
    "retrieved_at",
    "as_of_cutoff",
    "identifiers",
    "snapshot_scope",
    "timezone",
    "currency",
    "unit",
    "adjustment_basis",
    "rights_tag",
    "content_hash",
    "snapshot_path"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_type": {"const": "source"},
    "artifact_id": {"type": "string", "pattern": "^src_[0-9a-f]{64}$"},
    "source_kind": {
      "enum": [
        "filing",
        "sec-companyfacts",
        "sec-submissions",
        "provider-aggregate",
        "dataset",
        "web-document"
      ]
    },
    "provider": {"type": "string", "minLength": 1},
    "canonical_uri": {"type": "string", "minLength": 1},
    "query": {"type": "string"},
    "source_published_at": {"type": ["string", "null"], "format": "date-time"},
    "source_available_at": {"type": "string", "format": "date-time"},
    "availability_basis": {
      "enum": ["provider-publication", "filing-acceptance", "observed-at-retrieval"]
    },
    "retrieved_at": {"type": "string", "format": "date-time"},
    "as_of_cutoff": {"type": "string", "format": "date-time"},
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "security_id", "accessions"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "security_id": {"type": ["string", "null"]},
        "accessions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "snapshot_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "description"],
      "properties": {
        "representation": {
          "enum": ["complete-response", "filing", "document", "dataset"]
        },
        "description": {"type": "string", "minLength": 1}
      }
    },
    "timezone": {"type": "string", "minLength": 1},
    "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
    "unit": {"type": ["string", "null"], "minLength": 1},
    "adjustment_basis": {"type": ["string", "null"], "minLength": 1},
    "rights_tag": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "snapshot_path": {"type": "string", "minLength": 1}
  }
}
