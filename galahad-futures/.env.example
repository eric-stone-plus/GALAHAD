# Copy to .env and fill only if enabling live paths (default: paper, no keys needed).
# NEVER commit .env.

# Mode: paper | live  (live is hard-disabled unless KILL_SWITCH=0 AND mode=live)
GALAHAD_FUTURES_MODE=paper

# Kill switch: 1 = refuse live order placement (default safe)
GALAHAD_FUTURES_KILL_SWITCH=1

# Optional venue keys — only for live; paper mode ignores these.
# WARNING: this package ships NO mainnet path (mode=live is blocked
# unconditionally). These names are placeholders only and are never read.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Binance USDT-M futures TESTNET keys (testnet.binancefuture.com) — read ONLY
# by the testnet backend (--engine nautilus_live) and scripts/run_shadow.py.
# TESTNET ONLY: never put mainnet credentials in these variables.
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=

# Explicit opt-in for real testnet order placement (shadow runs / integration test)
# GALAHAD_TESTNET_IT=1

# Optional WS/REST egress for venue endpoints that need it (paper REST prefers vision first)
# HTTPS_PROXY=
